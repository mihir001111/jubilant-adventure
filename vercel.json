{
  "cleanUrls": true,

  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],

  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },

    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },

    {
      "source": "/terms",
      "destination": "/terms.html"
    },

    {
      "source": "/medical-disclaimer",
      "destination": "/medical-disclaimer.html"
    },

    {
      "source": "/gdpr",
      "destination": "/gdpr.html"
    },

    {
      "source": "/cookie",
      "destination": "/cookie.html"
    },

    {
      "source": "/guidelines",
      "destination": "/guidelines.html"
    },

    {
      "source": "/cookies",
      "destination": "/cookie.html"
    },

    {
      "source": "/careers",
      "destination": "/careers.html"
    },

    {
      "source": "/contact",
      "destination": "/contact.html"
    },

    {
      "source": "/blog/:slug",
      "destination": "/blogs.html?slug=:slug"
    }
  ]
}